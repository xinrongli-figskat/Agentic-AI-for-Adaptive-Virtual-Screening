      "offset": "character offset >=0",
      "limit": "integer 1..4000"
    },
    "list_candidates": {
      "kind": "targets, assays, evidence",
      "offset": "integer >=0",
      "limit": "integer 1..12"
    },
    "assess_source": {
      "assay_id": "inspected assay whose full description was read",
      "endpoint": "scientifically interpreted endpoint",
      "construct_or_receptor": "specific construct/receptor or unresolved",
      "status": "primary_review_required or blocked",
      "evidence_ids": "list of evidence IDs"
    },
    "decide_assay": {
      "assay_id": "inspected assay",
      "verdict": "reject, hold, or review_shortlist",
      "evidence_ids": "list of metadata/curation/source-assessment evidence IDs",
      "interpretation": "assay_defined_inhibition",
      "basis": "count_upper_bound, metadata_gate, curation_gate, source_problem, or resource_limit"
    },
    "finish": {}
  },
